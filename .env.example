# O app não usa chaves de APIs pagas. O Firebase é configurado em firebase-applet-config.json.

# Confirmação de lugar novo no cadastro (só o servidor usa; nunca commitar a chave real).
# Se houver TOMTOM_API_KEY ela é usada primeiro (cota grátis, sem cartão).
# Sem ela, cai no Google (exige faturamento ativo no projeto).
TOMTOM_API_KEY=
GOOGLE_PLACES_API_KEY=
