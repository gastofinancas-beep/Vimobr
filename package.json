{
  "name": "vimo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npx cap sync",
    "cap:assets": "npx capacitor-assets generate",
    "cap:ios": "vite build && npx cap sync ios && npx cap open ios",
    "cap:android": "vite build && npx cap sync android && npx cap open android",
    "test:regras": "npx firebase-tools emulators:exec --only firestore --project demo-vimo \"node testes/regras.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^11.8.1",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.511.0",
    "nsfwjs": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
